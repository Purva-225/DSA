class Solution {
public:
    int maxDepth(string s) {
       //maxi numb of nested parentheses
       //return such a number which is inside the nested parentheses 
       // ) <- decreasing, ( -> increasing
       int depth = 0;
       int maxDepth = 0; 
       for(int i = 0; i<s.size(); i++){
        if(s[i] == '(') depth++; 
         maxDepth = max(maxDepth, depth); 
          if(s[i] == ')') depth--; 
       }
      return maxDepth; 
    }
};
