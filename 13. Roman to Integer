class Solution {
public: 
        int val(char ch){
            switch(ch){
                case 'I': return 1; 
                case 'V': return 5; 
                case 'X': return 10; 
                case 'L': return 50; 
                case 'C': return 100; 
                case 'D': return 500; 
                case 'M': return 1000; 
            }
            return 0; 
    }
    int romanToInt(string s) {
        int ans = 0;
        for(int i =0; i<s.size()-1; i++){
            int CurrentValue = val(s[i]);
            int NextValue = val(s[i+1]);
            if(CurrentValue < NextValue) 
             ans -= CurrentValue; 
           else
            ans += CurrentValue; 
        }
       ans += val(s.back());
         return ans; 
    }
};
